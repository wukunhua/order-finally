# ============ 服务配置 ============
PORT=3000
# Web 管理端地址(用于 CORS);小程序请求域在微信后台配置
CORS_ORIGIN=http://localhost:5173

# ============ 数据库 ============
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=order_sys

# 若为 true,服务启动时按模型建表(开发便利);生产请保持 false,以 db/init.sql 为准
DB_SYNC=false

# ============ JWT ============
JWT_SECRET=please_change_this_secret_to_a_random_string
JWT_EXPIRES_IN=7d

# ============ 微信小程序(用于 wx-login 的 code2session) ============
# 没有真实凭证时,可调用 /api/auth/mock-login 用 mock openid 登录,无需这些
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# ============ 默认管理员(seed.js 使用) ============
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 上传文件访问基础地址(返回给前端的图片 URL 前缀)
PUBLIC_BASE_URL=http://localhost:3000
